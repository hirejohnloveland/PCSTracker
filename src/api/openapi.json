  "components": {
    "schemas": {
      "ApiProblemDetails": {
        "required": [
          "traceId",
          "errors"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "traceId": {
            "type": "string",
            "description": "Identifies the request in the server\u0027s logs and traces: the W3C trace id when there is one, otherwise the\nASP.NET Core trace identifier."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemError"
            },
            "description": "One entry for each failure found. A response has at least one."
          }
        },
        "description": "A failure response: the problem details of RFC 9457, the trace id of the request, and the errors behind the failure."
      },
      "ApiResponseMetadata": {
        "required": [
          "traceId",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "traceId": {
            "type": "string",
            "description": "Identifies the request. Quote it when reporting a problem."
          },
          "timestamp": {
            "type": "string",
            "description": "When the response was created, in UTC.",
            "format": "date-time"
          }
        },
        "description": "Describes one successful response."
      },
      "ApiResponseOfQuickbooksSyncResponseDto": {
        "required": [
          "data",
          "metadata"
        ],
        "type": "object",
        "properties": {
          "data": {
            "description": "The result of the use case.",
            "$ref": "#/components/schemas/QuickbooksSyncResponseDto"
          },
          "metadata": {
            "description": "Describes the response.",
            "$ref": "#/components/schemas/ApiResponseMetadata"
          }
        },
        "description": "The body of a successful response that carries one result. A response that carries a page of a list is a\nPagedApiResponse\u0026lt;T\u0026gt;."
      },
      "ApiResponseOfVendorInvoiceResponseDto": {
        "required": [
          "data",
          "metadata"
        ],
        "type": "object",
        "properties": {
          "data": {
            "description": "The result of the use case.",
            "$ref": "#/components/schemas/VendorInvoiceResponseDto"
          },
          "metadata": {
            "description": "Describes the response.",
            "$ref": "#/components/schemas/ApiResponseMetadata"
          }
        },
        "description": "The body of a successful response that carries one result. A response that carries a page of a list is a\nPagedApiResponse\u0026lt;T\u0026gt;."
      },
      "ApiResponseOfVendorResponseDto": {
        "required": [
          "data",
          "metadata"
        ],
        "type": "object",
        "properties": {
          "data": {
            "description": "The result of the use case.",
            "$ref": "#/components/schemas/VendorResponseDto"
          },
          "metadata": {
            "description": "Describes the response.",
            "$ref": "#/components/schemas/ApiResponseMetadata"
          }
        },
        "description": "The body of a successful response that carries one result. A response that carries a page of a list is a\nPagedApiResponse\u0026lt;T\u0026gt;."
      },
      "PagedApiResponseOfVendorResponseDto": {
        "required": [
          "data",
          "pagination",
          "metadata"
        ],
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VendorResponseDto"
            },
            "description": "The items on the page."
          },
          "pagination": {
            "description": "Where the page sits in the whole list.",
            "$ref": "#/components/schemas/PaginationMetadata"
          },
          "metadata": {
            "description": "Describes the response.",
            "$ref": "#/components/schemas/ApiResponseMetadata"
          }
        },
        "description": "The body of every successful response that carries one page of a list."
      },
      "PaginationMetadata": {
        "required": [
          "page",
          "pageSize",
          "totalCount",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "The 1-based number of the page that was requested.",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of items requested per page.",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "description": "The number of items across every page.",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "description": "The number of pages. 0 when there are no items.",
            "format": "int32"
          }
        },
        "description": "Where a page sits in the whole list."
      },
      "ProblemError": {
        "required": [
          "code",
          "detail",
          "pointer"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable identifier of the failure."
          },
          "detail": {
            "type": "string",
            "description": "What went wrong and, where possible, what to change."
          },
          "pointer": {
            "type": [
              "null",
              "string"
            ],
            "description": "Where in the request the fault is: a JSON Pointer to a body member, such as \u0060#/name\u0060, or \u0060#/\u0060 plus a query\nparameter name, such as \u0060#/pageSize\u0060. Only request problems have one."
          }
        },
        "description": "One entry in the \u0060errors\u0060 array of a problem response."
      },
      "QuickbooksSyncResponseDto": {
        "required": [
          "vendorsSynced"
        ],
        "type": "object",
        "properties": {
          "vendorsSynced": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "The outcome of a vendor sync with QuickBooks."
      },
      "VendorDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "contact": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "quickbooksId": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "The details of a vendor, supplied to create one or to replace the details of an existing one. A detail that is left\nout or blank is stored as none, except the name, which is required."
      },
      "VendorInvoiceDto": {
        "required": [
          "vendorName",
          "balance"
        ],
        "type": "object",
        "properties": {
          "vendorName": {
            "type": "string"
          },
          "balance": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "VendorInvoiceResponseDto": {
        "required": [
          "vendorName",
          "balance"
        ],
        "type": "object",
        "properties": {
          "vendorName": {
            "type": "string"
          },
          "balance": {
            "type": "number",
            "format": "double"
          }
        },
        "description": "A vendor invoice as the API reports it."
      },
      "VendorResponseDto": {
        "required": [
          "id",
          "name",
          "quickbooksId",
          "description",
          "contact",
          "phone",
          "notes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quickbooksId": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "contact": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A vendor as the API reports it. QuickbooksId is null for a vendor that is not linked to QuickBooks.\nDescription, Contact, Phone and Notes are\nnull when none was provided."
      }
    }
  },
